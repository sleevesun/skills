#!/usr/bin/env python3
"""hris-wiki — 跨项目 HRIS 知识库只读查询 CLI。

数据源分层（按权威度排序，query 输出自动标注）：
  ① 权威知识库   HR系统知识库/            现行权威口径，引用优先
  ② Repo Wiki    .qoder/repowiki/         派生 Wiki 页面与 Agent 知识卡
  ③ 历史归档摘要 各系统历史文档/          历史口径（2019-2024），引用注意时效
  ④ 进行中文档   进行中项目文档/          在途未定稿（默认不搜，--all 开启）

只读工具：只检索与输出；唯一的 git 写盘动作是本地镜像的克隆与快进更新，
永不修改知识仓内容、永不 commit / push。

定位知识仓（按优先级）：
  1. --repo <路径>（仅 query/show 等需要仓库的命令）
  2. 环境变量 HRIS_WIKI_REPO
  3. 环境变量 HRIS_KNOWLEDGE_REPO
  4. 自动镜像：浅克隆 CNB 中央仓到 ~/.cache/hris-wiki/HRIS（可用
     HRIS_WIKI_CACHE 覆盖缓存目录），每次运行时 git pull 保持新鲜。
     首次自动克隆需要身份认证：由用户输入公司邮箱（仅 @pwrd.com 放行）
     和管理员发放的 CNB 只读令牌；令牌经用户输入后保存到
     ~/.cache/hris-wiki/auth.json（权限 600）并用于镜像更新；
     非交互环境可改用环境变量 HRIS_WIKI_EMAIL=<邮箱> 与
     HRIS_WIKI_TOKEN=<令牌>。

用法：
  hris-wiki query [--or] [--all] <关键词>...
                                     全文检索（默认多词 AND，--or 任一命中）
  hris-wiki cards [关键词]           列出知识卡索引（_index.yaml）
  hris-wiki ref <源文件或目录路径>   反查引用某源文件/目录的 Wiki 页面
  hris-wiki show <页面相对路径>      输出页面全文（含 file:// 行级溯源）
  hris-wiki repo                     输出知识仓根路径
"""
import argparse
import json
import os
import re
import stat
import subprocess
import sys
from pathlib import Path

DEFAULT_REMOTE = "https://cnb.cool/Chordsun/HRIS.git"
REMOTE_HINT = "cnb.cool/Chordsun/HRIS"
ALLOWED_EMAIL_SUFFIX = "@pwrd.com"
ADMIN_HINT = "请联系知识库管理员获取 cnb.cool/Chordsun/HRIS 的只读访问令牌"
TIER_LABELS = {1: "① 权威知识库", 2: "② Repo Wiki", 3: "③ 历史归档", 4: "④ 进行中文档"}
# macOS iCloud 占位文件标记：读取会阻塞在云端取回，必须跳过
SF_DATALESS = 0x40000000


def cache_base() -> Path:
    base = os.environ.get("HRIS_WIKI_CACHE") or str(Path.home() / ".cache" / "hris-wiki")
    return Path(base).expanduser()


def mirror_dir() -> Path:
    return cache_base() / "HRIS"


def auth_path() -> Path:
    return cache_base() / "auth.json"


def load_auth() -> dict | None:
    try:
        data = json.loads(auth_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    email = str(data.get("email", "")).strip().lower()
    if email.endswith(ALLOWED_EMAIL_SUFFIX) and data.get("token"):
        return data
    return None


def prompt(message: str) -> str:
    if not sys.stdin.isatty():
        return ""
    print(message, file=sys.stderr)
    try:
        return input().strip()
    except EOFError:
        return ""


def ensure_auth() -> dict:
    """首次使用时要求公司邮箱认证并提供管理员发放的只读令牌，通过后保存到本地。"""
    auth = load_auth()
    if auth:
        return auth
    interactive = sys.stdin.isatty()

    email = os.environ.get("HRIS_WIKI_EMAIL", "").strip() or prompt(
        "首次使用需要身份认证，请输入你的公司邮箱（仅限 @pwrd.com）："
    )
    if not email.lower().endswith(ALLOWED_EMAIL_SUFFIX):
        print(
            f"ERROR: 认证失败：本知识库仅对公司内部开放（邮箱须以 {ALLOWED_EMAIL_SUFFIX} 结尾）。",
            file=sys.stderr,
        )
        sys.exit(1)

    token = os.environ.get("HRIS_WIKI_TOKEN", "").strip()
    if not token:
        token = prompt(f"请输入知识库管理员发放的 CNB 只读令牌（{ADMIN_HINT}）：")
    username = os.environ.get("HRIS_WIKI_USERNAME", "").strip()
    if not username:
        username = prompt("请输入令牌对应的 Git 用户名（不确定时直接回车，默认 cnb）：") or "cnb"
    if not token:
        print(
            "ERROR: 未提供访问令牌。"
            + ("非交互环境请设置 HRIS_WIKI_TOKEN=<令牌>（可选 HRIS_WIKI_USERNAME）。" if not interactive else "")
            + f"{ADMIN_HINT}。",
            file=sys.stderr,
        )
        sys.exit(1)

    auth = {"email": email, "username": username, "token": token}
    auth_path().parent.mkdir(parents=True, exist_ok=True)
    auth_path().write_text(json.dumps(auth, ensure_ascii=False, indent=2), encoding="utf-8")
    try:
        os.chmod(auth_path(), stat.S_IRUSR | stat.S_IWUSR)
    except OSError:
        pass
    print(f"认证通过（{email}），凭据已保存到 {auth_path()}，今后无需再次认证。", file=sys.stderr)
    return auth


def git_auth_header(auth: dict) -> str:
    import base64
    user_token = f"{auth['username']}:{auth['token']}".encode("utf-8")
    return "Authorization: Basic " + base64.b64encode(user_token).decode("ascii")


def sanitize_git_err(err_text: str) -> str:
    if not err_text:
        return ""
    return re.sub(r"://[^@\s]+@", "://***@", err_text)


def ensure_mirror() -> Path:
    dst = mirror_dir()
    auth = ensure_auth()
    header = git_auth_header(auth)
    git_cfg_args = ["-c", f"http.extraHeader={header}"]

    if (dst / ".git").is_dir():
        # 确保 origin 是纯净 URL，去除可能残留的历史明文 token
        subprocess.run(
            ["git", "-C", str(dst), "remote", "set-url", "origin", DEFAULT_REMOTE],
            capture_output=True,
        )
        pull = subprocess.run(
            ["git"] + git_cfg_args + ["-C", str(dst), "pull", "--ff-only", "--quiet"],
            capture_output=True,
            text=True,
        )
        if pull.returncode != 0:
            print(f"WARNING: 镜像更新失败（离线或凭据过期），沿用现有副本：{dst}", file=sys.stderr)
        return dst
    dst.parent.mkdir(parents=True, exist_ok=True)
    print(f"首次使用：浅克隆 {DEFAULT_REMOTE} -> {dst} ...", file=sys.stderr)
    clone = subprocess.run(
        ["git"] + git_cfg_args + ["clone", "--depth", "1", DEFAULT_REMOTE, str(dst)],
        capture_output=True,
        text=True,
    )
    if clone.returncode != 0:
        safe_err = sanitize_git_err(clone.stderr.strip())
        print(
            "ERROR: 自动克隆失败。"
            + (f" 详情: {safe_err}" if safe_err else "")
            + " 请确认令牌有效且具有读取权限；"
            f"令牌无效或已过期时{ADMIN_HINT}；也可手动 clone 后设置 HRIS_WIKI_REPO。",
            file=sys.stderr,
        )
        sys.exit(1)
    return dst


def repo_root(explicit: str | None = None) -> Path:
    raw = explicit or os.environ.get("HRIS_WIKI_REPO") or os.environ.get("HRIS_KNOWLEDGE_REPO")
    repo = Path(raw).expanduser() if raw else ensure_mirror()
    if not repo.is_dir():
        print(f"ERROR: HRIS 知识仓目录不存在：{repo}", file=sys.stderr)
        sys.exit(1)
    wiki = repo / ".qoder" / "repowiki"
    if not wiki.is_dir():
        print(f"ERROR: {repo} 下未找到 .qoder/repowiki，请确认是 HRIS 知识仓的完整 clone。", file=sys.stderr)
        sys.exit(1)
    return repo


def search_roots(repo: Path, all_layers: bool = False) -> list[tuple[int, Path]]:
    roots = [
        (1, repo / "HR系统知识库"),
        (2, repo / ".qoder" / "repowiki" / "knowledge" / "zh"),
        (2, repo / ".qoder" / "repowiki" / "zh" / "content"),
        (3, repo / "各系统历史文档"),
    ]
    if all_layers:
        roots.append((4, repo / "进行中项目文档"))
    return roots


def tokenize(args: list[str]) -> list[str]:
    return [t for a in args for t in a.split() if t]


def is_dataless(md: Path) -> bool:
    try:
        return bool(md.stat().st_flags & SF_DATALESS)
    except (AttributeError, OSError):
        return False


def last_commit_dates(repo: Path, rels: list[str], timed_out: list[bool]) -> dict[str, str]:
    """单次 git 调用批量取多个路径的最后提交年月。

    git 遍历树对象时若碰到云端未取回的对象会阻塞，
    因此必须整体限时并降级，而不是逐文件无限等待。
    浅克隆（自动镜像默认 --depth 1）看不到完整历史，直接返回空，
    避免所有文件都显示克隆日期造成假时效。
    """
    result: dict[str, str] = {}
    if not rels or (repo / ".git" / "shallow").exists():
        return result
    try:
        r = subprocess.run(
            ["git", "-c", "core.quotepath=false", "log", "--format=%cs", "--name-only", "--"] + rels,
            cwd=repo, capture_output=True, text=True, timeout=15,
        )
    except (subprocess.TimeoutExpired, OSError):
        timed_out.append(True)
        return result
    if r.returncode != 0:
        timed_out.append(True)
        return result
    date = None
    for line in r.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        if re.fullmatch(r"\d{4}-\d{2}-\d{2}", line):
            date = line[:7]
        elif date and line not in result:
            result[line] = date
    return result


def cmd_query(args: argparse.Namespace) -> int:
    keywords = tokenize(args.keywords)
    if not keywords:
        print("用法：hris-wiki query [--or] [--all] <关键词>...", file=sys.stderr)
        return 2
    repo = repo_root(args.repo)
    regexes = [re.compile(re.escape(k), re.IGNORECASE) for k in keywords]
    hits: list[tuple[int, Path, list[tuple[int, str]]]] = []
    total = 0
    skipped_dataless = 0
    for tier, root in search_roots(repo, all_layers=args.all_layers):
        if not root.is_dir():
            continue
        for md in sorted(root.rglob("*.md")):
            if is_dataless(md):
                skipped_dataless += 1
                continue
            rel = md.relative_to(repo)
            file_hits = []
            keywords_seen = set()
            try:
                for no, line in enumerate(md.read_text(encoding="utf-8").splitlines(), 1):
                    matched = [i for i, rx in enumerate(regexes) if rx.search(line)]
                    if matched:
                        keywords_seen.update(matched)
                        file_hits.append((no, line.strip()))
                        total += 1
            except OSError:
                continue
            if not file_hits:
                continue
            if not args.any_match and len(keywords_seen) < len(keywords):
                continue
            hits.append((tier, rel, file_hits))
    if not hits:
        mode = "任一" if args.any_match else "全部"
        print(f"未命中关键词（{mode}命中）：{' '.join(keywords)}")
        return 1
    hits.sort(key=lambda h: (h[0], str(h[1])))
    if skipped_dataless:
        print(f"（已跳过 {skipped_dataless} 个云端未取回的占位文件；如需纳入，请在访达中打开或 brctl download 后重试）")
    print(f"命中 {len(hits)} 个文件 / {total} 行（关键词：{' '.join(keywords)}{'，任一命中' if args.any_match else ''}）\n")
    slow_git: list[bool] = []
    dates = last_commit_dates(repo, [str(rel) for _, rel, _ in hits[:20]], slow_git)
    if slow_git:
        print("（git 查询日期超时：知识库部分 git 对象未取回，下方日期以 - 显示）")
    shown = 0
    fallback = "-" if slow_git else "未提交"
    for tier, rel, file_hits in hits:
        if shown >= 20:
            print(f"... 其余 {len(hits) - shown} 个文件省略，请用更精确的关键词")
            break
        key = str(rel)
        date = dates.get(key) or fallback
        print(f"## [{TIER_LABELS[tier]}|{date}] {rel}")
        for no, line in file_hits[:6]:
            text = line if len(line) <= 160 else line[:157] + "..."
            print(f"  L{no}: {text}")
        if len(file_hits) > 6:
            print(f"  ... 另 {len(file_hits) - 6} 行，用 `hris-wiki show` 查看全文")
        print()
        shown += 1
    print(
        "提示：hris-wiki show <页面相对路径> 查看全文；hris-wiki ref <源文件/目录> 反查引用。"
        "①为现行权威口径，③为历史口径注意时效。"
    )
    return 0


def cmd_cards(args: argparse.Namespace) -> int:
    keywords = tokenize(args.keywords)
    repo = repo_root(args.repo)
    index = repo / ".qoder" / "repowiki" / "knowledge" / "zh" / "_index.yaml"
    if not index.is_file():
        print(f"ERROR: 知识卡索引不存在：{index}", file=sys.stderr)
        return 1
    text = index.read_text(encoding="utf-8")
    if keywords:
        pattern = re.compile("|".join(re.escape(k) for k in keywords), re.IGNORECASE)
        text = "\n".join(l for l in text.splitlines() if pattern.search(l)) or "（无匹配）"
    print(text)
    return 0


def cmd_ref(args: argparse.Namespace) -> int:
    repo = repo_root(args.repo)
    src_index = repo / ".agent-wiki" / "source-index.json"
    if not src_index.is_file():
        print(f"ERROR: 公共索引不存在：{src_index}（知识仓可能不完整）", file=sys.stderr)
        return 1
    data = json.loads(src_index.read_text(encoding="utf-8"))
    mapping = data.get("source_to_pages") or data.get("sources") or {}
    pages_index = data.get("pages") or {}
    target = re.sub(r'^\./+', '', args.source)
    pages = mapping.get(target) or mapping.get(f"/{target}")
    if pages:
        print(f"引用 {target} 的页面（{len(pages)} 个）：")
        for p in pages:
            print(f"  {p}")
        return 0
    scope_hits: dict[str, list[str]] = {}
    norm = target.rstrip("/") + "/"
    for ppath, info in pages_index.items():
        for scope in info.get("source_scopes") or []:
            s = scope.rstrip("/") + "/"
            if norm.startswith(s):
                scope_hits.setdefault(ppath, []).append(scope)
    if scope_hits:
        print(f"{target} 位于以下目录来源范围内（scope 映射，{len(scope_hits)} 个页面）：")
        for p, scopes in sorted(scope_hits.items()):
            print(f"  {p}")
            print(f"    scope: {scopes[0]}")
        return 0
    fuzzy = {k: v for k, v in mapping.items() if target in k}
    if fuzzy:
        print(f"精确路径无映射，模糊匹配 {len(fuzzy)} 个源：")
        for k, v in list(fuzzy.items())[:10]:
            print(f"  {k}")
            for p in v:
                print(f"    -> {p}")
        return 0
    print(f"没有 Wiki 页面引用源文件：{target}")
    return 1


def cmd_show(args: argparse.Namespace) -> int:
    repo = repo_root(args.repo)
    page = (repo / args.page.lstrip("/")).resolve()
    try:
        page.relative_to(repo.resolve())
    except ValueError:
        print("ERROR: 页面路径必须位于知识仓内。", file=sys.stderr)
        return 1
    if not page.is_file():
        print(f"ERROR: 页面不存在：{args.page}", file=sys.stderr)
        return 1
    sys.stdout.write(page.read_text(encoding="utf-8"))
    return 0


def cmd_repo(args: argparse.Namespace) -> int:
    print(repo_root(args.repo))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="hris-wiki",
        description="跨项目 HRIS 知识库只读查询 CLI（分层检索：权威知识库 + Repo Wiki + 历史归档 + 知识卡）。",
    )
    parser.add_argument("--repo", help="知识仓路径（覆盖 HRIS_WIKI_REPO / HRIS_KNOWLEDGE_REPO）")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("query", help="全文检索（默认多词 AND，--or 任一命中）")
    p.add_argument("--or", dest="any_match", action="store_true", help="任一关键词命中即返回（旧行为）")
    p.add_argument("--all", dest="all_layers", action="store_true", help="追加搜索④进行中文档（在途未定稿）")
    p.add_argument("keywords", nargs="+")
    p.set_defaults(func=cmd_query)

    p = sub.add_parser("cards", help="列出知识卡索引")
    p.add_argument("keywords", nargs="*")
    p.set_defaults(func=cmd_cards)

    p = sub.add_parser("ref", help="反查引用某源文件/目录的 Wiki 页面")
    p.add_argument("source")
    p.set_defaults(func=cmd_ref)

    p = sub.add_parser("show", help="输出页面全文")
    p.add_argument("page")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("repo", help="输出知识仓根路径")
    p.set_defaults(func=cmd_repo)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
